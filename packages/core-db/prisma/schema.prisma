model TfdViagem {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String          @db.Uuid
  solicitacao_id        String          @db.Uuid
  sequencia             Int             @default(1)
  data_viagem           DateTime        @db.Date
  hora_saida            DateTime?       @db.Time
  veiculo_id            String?         @db.Uuid
  motorista_id          String?         @db.Uuid
  acompanhante_id       String?         @db.Uuid
  observacoes           String?         @db.Text
  status                TfdViagemStatus @default(AGENDADA)
  retorno_registrado_at DateTime?       @db.Timestamptz
  lembrete_48h_enviado_at DateTime?     @db.Timestamptz
  lembrete_48h_falhou_at  DateTime?     @db.Timestamptz
  created_at            DateTime        @default(now()) @db.Timestamptz
  updated_at            DateTime        @updatedAt @db.Timestamptz
  tenant                Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  solicitacao           TfdSolicitacao  @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)
  veiculo               TfdVeiculo?     @relation(fields: [veiculo_id], references: [id], onDelete: SetNull)
  motorista             TfdMotorista?   @relation(fields: [motorista_id], references: [id], onDelete: SetNull)
  acompanhante          TfdAcompanhante? @relation(fields: [acompanhante_id], references: [id], onDelete: SetNull)
  itens_despesa         TfdItemDespesa[]
  prestacao_conta       TfdPrestacaoConta?

  @@index([tenant_id], map: "idx_tfd_viagens_tenant")
  @@index([solicitacao_id], map: "idx_tfd_viagens_solicitacao")
  @@index([tenant_id, data_viagem], map: "idx_tfd_viagens_data")
  @@index([motorista_id], map: "idx_tfd_viagens_motorista")
  @@index([tenant_id, status], map: "idx_tfd_viagens_status")
  @@map("viagens")
  @@schema("saude_tfd")
}

model TfdItemDespesa {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String                  @db.Uuid
  viagem_id             String                  @db.Uuid
  tipo                  TfdTipoDespesa
  descricao             String?                 @db.VarChar(300)
  valor                 Decimal                 @db.Decimal(10, 2)
  comprovante_anexo_id  String?                 @db.Uuid
  responsavel_pagamento TfdResponsavelPagamento @default(MUNICIPIO)
  created_at            DateTime                @default(now()) @db.Timestamptz
  updated_at            DateTime                @updatedAt @db.Timestamptz
  tenant                Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  viagem                TfdViagem               @relation(fields: [viagem_id], references: [id], onDelete: Cascade)
  comprovante_anexo     Anexo?                  @relation("TfdDespesaComprovante", fields: [comprovante_anexo_id], references: [id], onDelete: SetNull)

  @@index([tenant_id], map: "idx_tfd_itens_despesa_tenant")
  @@index([viagem_id], map: "idx_tfd_despesas_viagem")
  @@map("itens_despesa")
  @@schema("saude_tfd")
}

model TfdPrestacaoConta {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String             @db.Uuid
  viagem_id           String             @unique @db.Uuid
  saldo_id            String?            @db.Uuid
  status              TfdPrestacaoStatus @default(PENDENTE)
  comprovantes_vistos Json               @default("[]")
  aprovado_por_id     String?            @db.Uuid
  aprovado_at         DateTime?          @db.Timestamptz
  observacoes_gestor  String?            @db.Text
  prazo_envio_at            DateTime           @db.Timestamptz
  lembrete_48h_enviado_at   DateTime?          @db.Timestamptz
  lembrete_48h_falhou_at    DateTime?          @db.Timestamptz
  created_at                DateTime           @default(now()) @db.Timestamptz
  updated_at                DateTime           @updatedAt @db.Timestamptz
  tenant                    Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  viagem                    TfdViagem          @relation(fields: [viagem_id], references: [id], onDelete: Cascade)
  saldo               TfdSaldo?          @relation(fields: [saldo_id], references: [id], onDelete: SetNull)
  aprovado_por        User?              @relation("TfdPrestacaoAprovado", fields: [aprovado_por_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, viagem_id], map: "uq_prestacao_viagem")
  @@index([tenant_id], map: "idx_tfd_prestacoes_conta_tenant")
  @@index([viagem_id], map: "idx_tfd_prestacoes_viagem")
  @@index([tenant_id, status], map: "idx_tfd_prestacoes_status")
  @@index([prazo_envio_at], map: "idx_tfd_prestacoes_prazo")
  @@map("prestacoes_conta")
  @@schema("saude_tfd")
}
