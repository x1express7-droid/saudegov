model TfdSolicitacao {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String               @db.Uuid
  processo_id             String               @db.Uuid
  paciente_id             String               @db.Uuid
  solicitante_id          String               @db.Uuid
  unidade_origem_id       String?              @db.Uuid
  especialidade_id        String?              @db.Uuid
  prestador_id            String?              @db.Uuid
  procedimentos           Json                 @default("[]")
  tipo_atendimento        TfdTipoAtendimento
  solicitacao_origem_id   String?              @db.Uuid
  urgencia                TfdUrgencia          @default(BAIXA)
  status                  TfdStatusSolicitacao @default(RASCUNHO)
  cid_principal           String?              @db.VarChar(10)
  diagnostico             String?              @db.Text
  laudo_anexo_id          String?              @db.Uuid
  acompanhante_necessario Boolean              @default(false)
  fundamentacao_decisao   String?              @db.Text
  decidido_por_id         String?              @db.Uuid
  decidido_at             DateTime?            @db.Timestamptz
  saldo_id                String?              @db.Uuid
  motivo_cancelamento     String?              @db.Text
  cancelado_por_id        String?              @db.Uuid
  cancelado_at            DateTime?            @db.Timestamptz
  observacoes_abertura    String?              @db.Text
  created_at              DateTime             @default(now()) @db.Timestamptz
  updated_at              DateTime             @updatedAt @db.Timestamptz
  tenant                  Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  processo                Processo             @relation(fields: [processo_id], references: [id], onDelete: Cascade)
  paciente                Paciente             @relation(fields: [paciente_id], references: [id])
  solicitante             User                 @relation("TfdSolicitante", fields: [solicitante_id], references: [id])
  unidade_origem          Unidade?             @relation(fields: [unidade_origem_id], references: [id], onDelete: SetNull)
  especialidade           TfdEspecialidade?    @relation(fields: [especialidade_id], references: [id], onDelete: SetNull)
  prestador               TfdPrestador?        @relation(fields: [prestador_id], references: [id], onDelete: SetNull)
  solicitacao_origem      TfdSolicitacao?      @relation("TfdSolicitacaoOrigem", fields: [solicitacao_origem_id], references: [id], onDelete: SetNull)
  solicitacoes_retorno    TfdSolicitacao[]     @relation("TfdSolicitacaoOrigem")
  laudo_anexo             Anexo?               @relation("TfdLaudoAnexo", fields: [laudo_anexo_id], references: [id], onDelete: SetNull)
  decidido_por            User?                @relation("TfdDecididoPor", fields: [decidido_por_id], references: [id], onDelete: SetNull)
  saldo                   TfdSaldo?            @relation(fields: [saldo_id], references: [id], onDelete: SetNull)
  cancelado_por           User?                @relation("TfdCanceladoPor", fields: [cancelado_por_id], references: [id], onDelete: SetNull)
  reservas                TfdReservaSaldo[]
  acompanhantes           TfdAcompanhante[]
  viagens                 TfdViagem[]

  @@index([tenant_id], map: "idx_tfd_sol_tenant")
  @@index([processo_id], map: "idx_tfd_sol_processo")
  @@index([paciente_id], map: "idx_tfd_sol_paciente")
  @@index([tenant_id, status], map: "idx_tfd_sol_status")
  @@index([tenant_id, urgencia], map: "idx_tfd_sol_urgencia")
  @@index([solicitacao_origem_id], map: "idx_tfd_sol_origem")
  @@map("solicitacoes")
  @@schema("saude_tfd")
}

