  lembrete_48h_enviado_at   DateTime?          @db.Timestamptz
  lembrete_48h_falhou_at    DateTime?          @db.Timestamptz
  created_at                DateTime           @default(now()) @db.Timestamptz
  updated_at                DateTime           @updatedAt @db.Timestamptz
  tenant                    Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  viagem                    TfdViagemLegado?   @relation(fields: [viagem_id], references: [id], onDelete: Cascade)
  viagem_nova               TfdViagem?         @relation(fields: [viagem_nova_id], references: [id], onDelete: SetNull)
