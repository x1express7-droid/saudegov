  viagens        TfdViagem[]

  @@index([tenant_id], map: "idx_tfd_acomp_tenant")
  @@index([solicitacao_id], map: "idx_tfd_acomp_solicitacao")
  @@map("acompanhantes")
  @@schema("saude_tfd")
}

