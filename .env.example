# =============================================================================
# saudegov — Variáveis de ambiente (exemplo)
# Copie para .env na raiz e preencha os valores. Nunca commite o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Usado pelo Prisma (@saude/core-db). Em produção: Neon ou outro PostgreSQL 15+.
# Desenvolvimento local: host localhost, banco saudegov (ver cursorrules §4).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/saudegov

# -----------------------------------------------------------------------------
# Autenticação (NextAuth v5 — AUTH_PERMISSIONS.md §11)
# AUTH_SECRET / NEXTAUTH_SECRET: mínimo 32 caracteres (ex.: openssl rand -base64 32)
# NEXTAUTH_URL: URL pública do app (painel-servidor: porta 3001 em dev)
# JWT_EXPIRY: expiração do JWT em segundos (padrão: 28800 = 8 horas)
# -----------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
JWT_EXPIRY=28800

# -----------------------------------------------------------------------------
# Painel Dev
# ADMIN_DOMAIN: domínio do Painel Dev — não resolve tenant (MULTI_TENANT.md §14)
# SUPERADMIN_ALLOWED_IPS: IPs permitidos, separados por vírgula
# -----------------------------------------------------------------------------
ADMIN_DOMAIN=admin.saudemunic.com.br
SUPERADMIN_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# Multi-tenant
# DEV_TENANT_SLUG: slug do município simulado em desenvolvimento local (painel-servidor)
# TENANT_CACHE_TTL_MS: TTL do cache do Tenant Resolver em ms (padrão: 300000 = 5 min; use 0 em dev para desabilitar)
# -----------------------------------------------------------------------------
DEV_TENANT_SLUG=campo-grande-ms
TENANT_CACHE_TTL_MS=300000

# -----------------------------------------------------------------------------
# Cloudflare (DNS e domínios por município — Painel Dev)
# CF_API_TOKEN: token com permissão de edição de DNS
# CF_ZONE_ID: ID da zona saudemunic.com.br no Cloudflare
# -----------------------------------------------------------------------------
CF_API_TOKEN=
CF_ZONE_ID=

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (laudos, anexos — S3 ou Cloudflare R2)
# Usado por @saude/core-documents. Em R2, STORAGE_ENDPOINT é a URL compatível com S3.
# -----------------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
