# =============================================================================
# saudegov — Variáveis de ambiente (exemplo)
# Copie para .env na raiz e preencha os valores. Nunca commite o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Usado pelo Prisma (@saude/core-db). Em produção: Neon ou outro PostgreSQL 15+.
# Desenvolvimento local: host localhost, banco saudegov (ver cursorrules §4).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/saudegov

# -----------------------------------------------------------------------------
# Autenticação (NextAuth v5 — AUTH_PERMISSIONS.md §11)
# AUTH_SECRET / NEXTAUTH_SECRET: mínimo 32 caracteres (ex.: openssl rand -base64 32)
# NEXTAUTH_URL: URL pública do app (painel-servidor: porta 3001 em dev)
# JWT_EXPIRY: expiração do JWT em segundos (padrão: 28800 = 8 horas)
# -----------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_SECRET=
# Em produção (Coolify): use a URL pública exata com https (igual à que o usuário abre no navegador).
NEXTAUTH_URL=http://localhost:3001
# Auth.js v5 também lê AUTH_URL; defina o mesmo valor que NEXTAUTH_URL no deploy.
# AUTH_URL=http://localhost:3001
# AUTH_TRUST_HOST=true
# Em dev local (HTTP) o core-auth já desativa cookies Secure; use false explicitamente em staging HTTP:
AUTH_COOKIE_SECURE=false
JWT_EXPIRY=28800

# -----------------------------------------------------------------------------
# Painel Dev
# ADMIN_DOMAIN: domínio do Painel Dev — não resolve tenant (MULTI_TENANT.md §14)
# SUPERADMIN_ALLOWED_IPS: IPs permitidos, separados por vírgula
# -----------------------------------------------------------------------------
ADMIN_DOMAIN=admin.plataforma.exemplo
SUPERADMIN_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# Multi-tenant
# DEV_TENANT_*: tenant simulado em localhost:3001 (painel-servidor / middleware Edge)
# Se DEV_TENANT_ID estiver vazio, o middleware consulta o banco via slug abaixo.
# -----------------------------------------------------------------------------
DEV_TENANT_SLUG=campograndems
# DEV_TENANT_ID=
# DEV_TENANT_NAME=Prefeitura Municipal de Campo Grande
# Obrigatório em produção no painel-servidor (middleware chama /api/internal/tenant-by-domain).
# Gere com: openssl rand -base64 32
MIDDLEWARE_INTERNAL_SECRET=
# No painel-dev Docker: seed idempotente após migrate. Use true para pular em produção real.
# SKIP_DB_SEED=true

# -----------------------------------------------------------------------------
# Cloudflare (DNS e domínios por município — Painel Dev)
# CF_ZONE_ID: ID da zona DNS do domínio-base da plataforma no Cloudflare
# CF_API_TOKEN: token com permissão de edição de DNS
# CF_VERCEL_TARGET: destino dos CNAMEs dos municípios (host do painel-servidor na VPS/Coolify)
# -----------------------------------------------------------------------------
CF_ZONE_ID=
CF_API_TOKEN=
CF_VERCEL_TARGET=

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (laudos, anexos — @saude/core-documents)
# STORAGE_PROVIDER: local (dev) | r2 | s3 (produção — integração completa Sprint 2.x)
# URLs de upload/download são assinadas (padrão: 15 min upload, 60 min download).
# local: arquivos em STORAGE_LOCAL_ROOT (padrão: .data/storage na raiz do projeto)
# r2/s3: preencha credenciais; STORAGE_ENDPOINT obrigatório para R2
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Opcional (dev): diretório base e URL pública para links assinados locais
# STORAGE_LOCAL_ROOT=.data/storage
# STORAGE_PUBLIC_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# SMTP da plataforma (modelo híbrido — DECISIONS.md D12)
# Padrão usado por todos os municípios quando tenants.settings.smtp_custom_enabled
# é false. Override por tenant (host, user, from, etc.) — Sprint 2.x; senha do
# tenant em smtp_password_enc (criptografia reversível), nunca em texto claro.
# Sprint 1.4: core-notifications usa somente estas variáveis.
# -----------------------------------------------------------------------------
SMTP_PLATFORM_HOST=
SMTP_PLATFORM_PORT=587
SMTP_PLATFORM_USER=
SMTP_PLATFORM_PASSWORD=
SMTP_PLATFORM_FROM=
SMTP_PLATFORM_SECURE=true
